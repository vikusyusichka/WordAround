  "notesTemplateApplyHint": { "en": "This note already has content. Choose how to apply the template.", "uk": "Ця нотатка вже має вміст. Оберіть, як застосувати шаблон.", "es": "Esta nota ya tiene contenido. Elige cómo aplicar la plantilla.", "fr": "Cette note a déjà du contenu. Choisissez comment appliquer le modèle.", "de": "Diese Notiz hat bereits Inhalt. Wähle, wie die Vorlage angewendet wird.", "it": "Questa nota ha già contenuto. Scegli come applicare il modello.", "pt": "Esta nota já tem conteúdo. Escolha como aplicar o modelo.", "ru": "Эта заметка уже содержит контент. Выберите, как применить шаблон.", "pl": "Ta notatka już ma treść. Wybierz, jak zastosować szablon.", "nl": "Deze notitie heeft al inhoud. Kies hoe je het sjabloon toepast.", "ja": "このノートには既に内容があります。テンプレートの適用方法を選んでください。", "ko": "이 노트에는 이미 콘텐츠가 있습니다. 템플릿 적용 방법을 선택하세요.", "zh": "此笔记已有内容。选择如何应用模板。", "hi": "इस नोट में पहले से सामग्री है। टेम्पलेट लागू करने का तरीका चुनें।", "ar": "تحتوي هذه الملاحظة على محتوى بالفعل. اختر كيفية تطبيق القالب.", "bn": "এই নোটে ইতিমধ্যে বিষয়বস্তু রয়েছে। কীভাবে টেমপ্লেট প্রয়োগ করবেন বেছে নিন।", "ur": "اس نوٹ میں پہلے ہی مواد ہے۔ ٹیمپلیٹ لگانے کا طریقہ منتخب کریں۔", "id": "Catatan ini sudah memiliki konten. Pilih cara menerapkan templat.", "tr": "Bu notta zaten içerik var. Şablonun nasıl uygulanacağını seç.", "vi": "Ghi chú này đã có nội dung. Chọn cách áp dụng mẫu.", "fa": "این یادداشت قبلاً محتوا دارد. نحوه اعمال قالب را انتخاب کنید.", "ro": "Această notiță are deja conținut. Alege cum să aplici șablonul.", "th": "บันทึกนี้มีเนื้อหาอยู่แล้ว เลือกวิธีใช้เทมเพลต", "el": "Αυτή η σημείωση έχει ήδη περιεχόμενο. Διάλεξε πώς να εφαρμόσεις το πρότυπο.", "cs": "Tato poznámka už má obsah. Vyber, jak použít šablonu.", "hu": "Ennek a jegyzetnek már van tartalma. Válaszd ki, hogyan alkalmazd a sablont.", "sv": "Den här anteckningen har redan innehåll. Välj hur mallen ska tillämpas.", "he": "להערה זו כבר יש תוכן. בחר כיצד להחיל את התבנית.", "no": "Dette notatet har allerede innhold. Velg hvordan malen skal brukes.", "da": "Denne note har allerede indhold. Vælg, hvordan skabelonen anvendes.", "fi": "Tällä muistiinpanolla on jo sisältöä. Valitse, miten malli sovelletaan.", "bg": "Тази бележка вече има съдържание. Изберете как да приложите шаблона." },
  "notesDeleteThisNote": { "en": "Delete this note?", "uk": "Видалити цю нотатку?", "es": "¿Eliminar esta nota?", "fr": "Supprimer cette note ?", "de": "Diese Notiz löschen?", "it": "Eliminare questa nota?", "pt": "Excluir esta nota?", "ru": "Удалить эту заметку?", "pl": "Usunąć tę notatkę?", "nl": "Deze notitie verwijderen?", "ja": "このノートを削除しますか?", "ko": "이 노트를 삭제할까요?", "zh": "删除此笔记?", "hi": "इस नोट को हटाएं?", "ar": "حذف هذه الملاحظة؟", "bn": "এই নোটটি মুছবেন?", "ur": "یہ نوٹ حذف کریں؟", "id": "Hapus catatan ini?", "tr": "Bu notu sil?", "vi": "Xóa ghi chú này?", "fa": "این یادداشت حذف شود؟", "ro": "Ștergi această notiță?", "th": "ลบบันทึกนี้?", "el": "Διαγραφή αυτής της σημείωσης;", "cs": "Smazat tuto poznámku?", "hu": "Törlöd ezt a jegyzetet?", "sv": "Radera den här anteckningen?", "he": "למחוק את ההערה הזו?", "no": "Slette dette notatet?", "da": "Slet denne note?", "fi": "Poistetaanko tämä muistiinpano?", "bg": "Изтриване на тази бележка?" },
  "notesDeleteNote": { "en": "Delete Note", "uk": "Видалити нотатку", "es": "Eliminar nota", "fr": "Supprimer la note", "de": "Notiz löschen", "it": "Elimina nota", "pt": "Excluir nota", "ru": "Удалить заметку", "pl": "Usuń notatkę", "nl": "Notitie verwijderen", "ja": "ノートを削除", "ko": "노트 삭제", "zh": "删除笔记", "hi": "नोट हटाएं", "ar": "حذف الملاحظة", "bn": "নোট মুছুন", "ur": "نوٹ حذف کریں", "id": "Hapus catatan", "tr": "Notu sil", "vi": "Xóa ghi chú", "fa": "حذف یادداشت", "ro": "Șterge notița", "th": "ลบบันทึก", "el": "Διαγραφή σημείωσης", "cs": "Smazat poznámku", "hu": "Jegyzet törlése", "sv": "Radera anteckning", "he": "מחק הערה", "no": "Slett notat", "da": "Slet note", "fi": "Poista muistiinpano", "bg": "Изтрий бележката" },
  "notesDeletePermanent": { "en": "This note and its content will be permanently deleted.", "uk": "Цю нотатку та її вміст буде остаточно видалено.", "es": "Esta nota y su contenido se eliminarán permanentemente.", "fr": "Cette note et son contenu seront définitivement supprimés.", "de": "Diese Notiz und ihr Inhalt werden dauerhaft gelöscht.", "it": "Questa nota e il suo contenuto saranno eliminati definitivamente.", "pt": "Esta nota e seu conteúdo serão excluídos permanentemente.", "ru": "Эта заметка и её содержимое будут удалены навсегда.", "pl": "Ta notatka i jej zawartość zostaną trwale usunięte.", "nl": "Deze notitie en de inhoud worden permanent verwijderd.", "ja": "このノートとその内容は完全に削除されます。", "ko": "이 노트와 콘텐츠가 영구적으로 삭제됩니다.", "zh": "此笔记及其内容将被永久删除。", "hi": "यह नोट और इसकी सामग्री स्थायी रूप से हटा दी जाएगी।", "ar": "ستُحذف هذه الملاحظة ومحتواها نهائيًا.", "bn": "এই নোট ও এর বিষয়বস্তু স্থায়ীভাবে মুছে যাবে।", "ur": "یہ نوٹ اور اس کا مواد مستقل طور پر حذف ہو جائے گا۔", "id": "Catatan ini dan isinya akan dihapus secara permanen.", "tr": "Bu not ve içeriği kalıcı olarak silinecek.", "vi": "Ghi chú này và nội dung sẽ bị xóa vĩnh viễn.", "fa": "این یادداشت و محتوای آن برای همیشه حذف می‌شود.", "ro": "Această notiță și conținutul ei vor fi șterse permanent.", "th": "บันทึกนี้และเนื้อหาจะถูกลบอย่างถาวร", "el": "Αυτή η σημείωση και το περιεχόμενό της θα διαγραφούν οριστικά.", "cs": "Tato poznámka a její obsah budou trvale smazány.", "hu": "Ez a jegyzet és tartalma véglegesen törlésre kerül.", "sv": "Den här anteckningen och dess innehåll raderas permanent.", "he": "ההערה ותוכנה יימחקו לצמיתות.", "no": "Dette notatet og innholdet slettes permanent.", "da": "Denne note og dens indhold slettes permanent.", "fi": "Tämä muistiinpano ja sen sisältö poistetaan pysyvästi.", "bg": "Тази бележка и съдържанието ѝ ще бъдат изтрити завинаги." },
